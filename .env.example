# Google OAuth (YouTube Data API v3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Server
PORT=3000

# Detection tuning
# Interval in seconds between sampled frames during face/person detection
DETECTION_SAMPLE_INTERVAL_SEC=0.3
# Gap (seconds) below which two nearby detections are merged into one candidate interval
DETECTION_MERGE_GAP_SEC=1.0
# Minimum confidence (0-1) to keep a detection
DETECTION_MIN_CONFIDENCE=0.5
